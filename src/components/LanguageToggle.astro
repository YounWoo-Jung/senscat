---
interface Props {
  currentLocale: 'ko' | 'en';
}

const { currentLocale } = Astro.props;
const otherLocale = currentLocale === 'ko' ? 'en' : 'ko';
const currentPath = Astro.url.pathname;
const newPath = currentLocale === 'ko' 
  ? `/en${currentPath === '/' ? '' : currentPath}`
  : currentPath.replace(/^\/en/, '') || '/';
---

<a
  href={newPath}
  class="rounded-full px-3 py-2 text-sm font-semibold text-stone-600 transition-colors hover:bg-stone-900/5 hover:text-stone-900 dark:text-stone-300 dark:hover:bg-white/10 dark:hover:text-white"
  aria-label={`Switch to ${otherLocale}`}
>
  {currentLocale === 'ko' ? 'EN' : 'KO'}
</a>
