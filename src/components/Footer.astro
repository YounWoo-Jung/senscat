---
import { getTranslations, type Locale } from '../i18n';
import { config } from '../config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const localePrefix = locale === 'ko' ? '' : `/${locale}`;
---

<footer class="bg-gray-50 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 mt-16">
  <div class="container mx-auto px-4 py-10">
    <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="text-lg font-semibold">{config.company.name}</p>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{config.site.tagline}</p>
        <nav class="mt-5 flex flex-wrap gap-4 text-sm">
          <a href={`${localePrefix}/about`} class="hover:opacity-80 transition-opacity">
            {t.footer.about}
          </a>
          <a href={`${localePrefix}/contact`} class="hover:opacity-80 transition-opacity">
            {t.footer.contact}
          </a>
          <a href={`${localePrefix}/privacy`} class="hover:opacity-80 transition-opacity">
            {t.footer.privacy}
          </a>
          <a href={`${localePrefix}/terms`} class="hover:opacity-80 transition-opacity">
            {t.footer.terms}
          </a>
        </nav>
      </div>
      <dl class="grid gap-x-6 gap-y-2 text-xs text-gray-600 dark:text-gray-400 sm:grid-cols-2">
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">상호명</dt><dd>{config.company.name}</dd></div>
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">대표</dt><dd>{config.company.ceo}</dd></div>
        <div class="sm:col-span-2"><dt class="font-semibold text-gray-900 dark:text-gray-100">주소</dt><dd>{config.company.address}</dd></div>
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">사업자등록번호</dt><dd>{config.company.businessNumber}</dd></div>
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">통신판매업신고</dt><dd>{config.company.ecommerceRegistration}</dd></div>
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">개인정보관리책임자</dt><dd>{config.company.privacyOfficer}</dd></div>
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">이메일</dt><dd><a href={`mailto:${config.company.email}`} class="hover:underline">{config.company.email}</a></dd></div>
      </dl>
    </div>
    <div class="mt-8 border-t border-gray-200 pt-5 dark:border-gray-700">
      <p class="text-sm text-gray-600 dark:text-gray-400">{t.footer.copyright}</p>
    </div>
  </div>
</footer>
