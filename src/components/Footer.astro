---
import { getTranslations, type Locale } from '../i18n';
import { config } from '../config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const localePrefix = locale === 'ko' ? '' : `/${locale}`;
const footerDescription = locale === 'ko'
  ? 'AI 서비스 아이디어를 제품으로 만들고, 운영 데이터로 개선하는 디지털 제품 스튜디오입니다.'
  : 'A digital product studio that turns AI service ideas into products and improves them with operating data.';
---

<footer class="mt-20 border-t border-gray-200 bg-white dark:border-gray-800 dark:bg-[#0b0f14]">
  <div class="container mx-auto px-4 py-10">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.25fr]">
      <div>
        <p class="text-lg font-semibold">{config.company.name}</p>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-gray-600 dark:text-gray-400">
          {footerDescription}
        </p>
        <nav class="mt-5 flex flex-wrap gap-2 text-sm">
          <a href={`${localePrefix}/about`} class="rounded-md px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-900">
            {t.footer.about}
          </a>
          <a href={`${localePrefix}/contact`} class="rounded-md px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-900">
            {t.footer.contact}
          </a>
          <a href={`${localePrefix}/privacy`} class="rounded-md px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-900">
            {t.footer.privacy}
          </a>
          <a href={`${localePrefix}/terms`} class="rounded-md px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-900">
            {t.footer.terms}
          </a>
        </nav>
      </div>
      <dl class="grid gap-x-6 gap-y-3 text-xs text-gray-600 dark:text-gray-400 sm:grid-cols-2">
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">상호명</dt><dd>{config.company.name}</dd></div>
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">대표</dt><dd>{config.company.ceo}</dd></div>
        <div class="sm:col-span-2"><dt class="font-semibold text-gray-900 dark:text-gray-100">주소</dt><dd>{config.company.address}</dd></div>
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">사업자등록번호</dt><dd>{config.company.businessNumber}</dd></div>
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">통신판매업신고</dt><dd>{config.company.ecommerceRegistration}</dd></div>
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">개인정보관리책임자</dt><dd>{config.company.privacyOfficer}</dd></div>
        <div><dt class="font-semibold text-gray-900 dark:text-gray-100">이메일</dt><dd><a href={`mailto:${config.company.email}`} class="hover:underline">{config.company.email}</a></dd></div>
      </dl>
    </div>
    <div class="mt-8 border-t border-gray-200 pt-5 dark:border-gray-800">
      <p class="text-sm text-gray-600 dark:text-gray-400">{t.footer.copyright}</p>
    </div>
  </div>
</footer>
