---
import { getTranslations, type Locale } from '../i18n';
import { config } from '../config';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const localePrefix = locale === 'ko' ? '' : `/${locale}`;
const footerDescription = locale === 'ko'
  ? 'AI 서비스 아이디어를 제품으로 만들고, 운영 데이터로 개선하는 디지털 제품 스튜디오입니다.'
  : 'A digital product studio that turns AI service ideas into products and improves them with operating data.';
const linkClass = 'rounded-full px-3.5 py-2 font-medium text-stone-600 ring-1 ring-inset ring-stone-900/10 transition-colors hover:bg-stone-900/5 hover:text-stone-900 dark:text-stone-300 dark:ring-white/10 dark:hover:bg-white/10 dark:hover:text-white';
---

<footer class="mt-20 border-t border-stone-900/5 bg-white/70 dark:border-white/10 dark:bg-white/[0.02]">
  <div class="container mx-auto px-4 py-14">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.25fr]">
      <div>
        <a href={`${localePrefix}/`} class="inline-flex items-center gap-2.5">
          <Logo id="footer" class="h-10 w-10" />
          <span class="text-lg font-extrabold tracking-tight">{config.company.name}</span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-stone-600 dark:text-stone-400">
          {footerDescription}
        </p>
        <nav class="mt-6 flex flex-wrap gap-2 text-sm">
          <a href={`${localePrefix}/about`} class={linkClass}>{t.footer.about}</a>
          <a href={`${localePrefix}/contact`} class={linkClass}>{t.footer.contact}</a>
          <a href={`${localePrefix}/privacy`} class={linkClass}>{t.footer.privacy}</a>
          <a href={`${localePrefix}/terms`} class={linkClass}>{t.footer.terms}</a>
        </nav>
      </div>
      <dl class="grid gap-x-8 gap-y-4 rounded-[1.75rem] border border-stone-200/80 bg-[#fffaf5] p-6 text-xs text-stone-600 dark:border-white/10 dark:bg-white/[0.03] dark:text-stone-400 sm:grid-cols-2">
        <div><dt class="font-semibold text-stone-900 dark:text-stone-100">상호명</dt><dd class="mt-1">{config.company.name}</dd></div>
        <div><dt class="font-semibold text-stone-900 dark:text-stone-100">대표</dt><dd class="mt-1">{config.company.ceo}</dd></div>
        <div class="sm:col-span-2"><dt class="font-semibold text-stone-900 dark:text-stone-100">주소</dt><dd class="mt-1">{config.company.address}</dd></div>
        <div><dt class="font-semibold text-stone-900 dark:text-stone-100">사업자등록번호</dt><dd class="mt-1">{config.company.businessNumber}</dd></div>
        <div><dt class="font-semibold text-stone-900 dark:text-stone-100">통신판매업신고</dt><dd class="mt-1">{config.company.ecommerceRegistration}</dd></div>
        <div><dt class="font-semibold text-stone-900 dark:text-stone-100">개인정보관리책임자</dt><dd class="mt-1">{config.company.privacyOfficer}</dd></div>
        <div><dt class="font-semibold text-stone-900 dark:text-stone-100">이메일</dt><dd class="mt-1"><a href={`mailto:${config.company.email}`} class="hover:text-orange-600 hover:underline dark:hover:text-orange-300">{config.company.email}</a></dd></div>
      </dl>
    </div>
    <div class="mt-10 border-t border-stone-900/5 pt-6 dark:border-white/10">
      <p class="text-sm text-stone-500 dark:text-stone-400">{t.footer.copyright}</p>
    </div>
  </div>
</footer>
