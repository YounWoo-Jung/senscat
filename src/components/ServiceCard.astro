---
import { config } from '../config';
import type { Locale } from '../i18n';

interface Props {
  service: typeof config.services[number];
  locale: Locale;
}

const { service, locale } = Astro.props;
const description = locale === 'ko' ? service.description : service.descriptionEn;
const buttonText = locale === 'ko' ? '방문하기' : 'Visit';
---

<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-shadow p-6 border border-gray-200 dark:border-gray-700">
  <div class="text-4xl mb-4">{service.icon}</div>
  <h3 class="text-xl font-semibold mb-2">{service.name}</h3>
  <p class="text-gray-600 dark:text-gray-400 mb-4">{description}</p>
  <a 
    href={service.url} 
    target="_blank" 
    rel="noopener noreferrer"
    class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition-colors"
  >
    {buttonText}
  </a>
</div>
