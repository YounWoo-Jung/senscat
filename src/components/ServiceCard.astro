---
import { config } from '../config';
import type { Locale } from '../i18n';

interface Props {
  service: typeof config.services[number];
  locale: Locale;
}

const { service, locale } = Astro.props;
const description = locale === 'ko' ? service.description : service.descriptionEn;
const buttonText = locale === 'ko' ? '방문하기' : 'Visit';
const isExternal = service.url.startsWith('http');
---

<div class="group rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 hover:shadow-lg transition-shadow">
  <div class="flex items-center justify-between mb-6">
    <div class="h-12 w-12 rounded-lg bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-xl">
      {service.icon}
    </div>
    <span class="text-xs font-medium rounded-full bg-gray-100 dark:bg-gray-800 px-3 py-1 text-gray-600 dark:text-gray-300">{service.status}</span>
  </div>
  <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2">{service.category}</p>
  <h3 class="text-xl font-semibold mb-3">{service.name}</h3>
  <p class="text-gray-600 dark:text-gray-400 mb-5 leading-relaxed">{description}</p>
  <ul class="mb-6 space-y-2 text-sm text-gray-600 dark:text-gray-400">
    {service.features.map((feature) => (
      <li class="flex gap-2">
        <span class="mt-2 h-1.5 w-1.5 rounded-full bg-gray-900 dark:bg-gray-100"></span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>
  <a 
    href={service.url} 
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
  >
    {buttonText}
    <span class="h-1.5 w-1.5 rounded-full bg-current inline-block"></span>
  </a>
</div>
