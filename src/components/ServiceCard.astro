---
import { config } from '../config';
import type { Locale } from '../i18n';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  service: typeof config.services[number];
  locale: Locale;
}

const { service, locale } = Astro.props;
const description = locale === 'ko' ? service.description : service.descriptionEn;
const buttonText = locale === 'ko' ? '방문하기' : 'Visit';
const isExternal = service.url.startsWith('http');
const isOperating = service.status === '운영';
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-stone-200/80 bg-white p-7 shadow-sm shadow-stone-900/[0.03] transition duration-300 hover:-translate-y-1 hover:border-orange-200 hover:shadow-xl hover:shadow-orange-900/10 dark:border-white/10 dark:bg-white/[0.04] dark:hover:border-white/20">
  <div class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-orange-200/50 opacity-0 blur-3xl transition-opacity duration-300 group-hover:opacity-100 dark:bg-orange-500/15" aria-hidden="true"></div>
  <div class="relative flex items-start justify-between">
    <ServiceIcon id={service.id} size="lg" />
    <span
      class:list={[
        'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset',
        isOperating
          ? 'bg-emerald-50 text-emerald-700 ring-emerald-600/15 dark:bg-emerald-400/10 dark:text-emerald-300 dark:ring-emerald-400/20'
          : 'bg-violet-50 text-violet-700 ring-violet-600/15 dark:bg-violet-400/10 dark:text-violet-300 dark:ring-violet-400/20',
      ]}
    >
      <span class:list={['h-1.5 w-1.5 rounded-full', isOperating ? 'bg-emerald-500' : 'bg-violet-500']}></span>
      {service.status}
    </span>
  </div>
  <p class="relative mt-7 text-sm font-semibold text-stone-500 dark:text-stone-400">{service.category}</p>
  <h3 class="relative mt-1 text-2xl font-bold tracking-tight">{service.name}</h3>
  <p class="relative mt-3 leading-relaxed text-stone-600 dark:text-stone-300">{description}</p>
  <ul class="relative mt-6 space-y-2.5 text-sm font-medium text-stone-700 dark:text-stone-300">
    {service.features.map((feature) => (
      <li class="flex items-center gap-2.5">
        <svg class="h-5 w-5 shrink-0 text-orange-500 dark:text-orange-300" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="8" fill="currentColor" opacity=".15" />
          <path d="m6.5 10.2 2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{feature}</span>
      </li>
    ))}
  </ul>
  <div class="relative mt-auto pt-8">
    <a
      href={service.url}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      class="inline-flex items-center gap-2 rounded-full bg-stone-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-500 dark:bg-white dark:text-stone-900 dark:hover:bg-orange-300"
    >
      {buttonText}
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 10h11m-4-4.5 4.5 4.5-4.5 4.5" />
      </svg>
    </a>
  </div>
</article>
