---
import { config } from '../config';
import type { Locale } from '../i18n';

interface Props {
  service: typeof config.services[number];
  locale: Locale;
}

const { service, locale } = Astro.props;
const description = locale === 'ko' ? service.description : service.descriptionEn;
const buttonText = locale === 'ko' ? '방문하기' : 'Visit';
const initials = service.name.slice(0, 2).toUpperCase();
---

<div class="group rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/70 backdrop-blur p-6 hover:shadow-xl transition-shadow">
  <div class="flex items-center justify-between mb-6">
    <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-blue-500/20 via-purple-500/20 to-pink-500/20 flex items-center justify-center text-sm font-semibold text-gray-700 dark:text-gray-200">
      {initials}
    </div>
    <span class="text-xs uppercase tracking-[0.2em] text-gray-400">{service.id}</span>
  </div>
  <h3 class="text-xl font-semibold mb-2">{service.name}</h3>
  <p class="text-gray-600 dark:text-gray-400 mb-6">{description}</p>
  <a 
    href={service.url} 
    target="_blank" 
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
  >
    {buttonText}
    <span class="h-1.5 w-1.5 rounded-full bg-current inline-block"></span>
  </a>
</div>
