---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { getTranslations } from '../i18n';
import ServiceCard from '../components/ServiceCard.astro';

const locale = 'ko';
const t = getTranslations(locale);
---

<BaseLayout title={`${t.site.name} — ${config.site.tagline}`} locale={locale}>
  <div>
    <div class="container mx-auto px-4 py-16">
      <!-- Hero Section -->
      <section class="mb-20">
        <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.25em] text-gray-500 dark:text-gray-400">Senscat Company</p>
            <h1 class="mt-5 text-4xl md:text-6xl font-semibold tracking-tight leading-tight">
              디지털 서비스를 직접 만들고 운영하는 회사, 센스냥
            </h1>
            <p class="mt-6 text-lg md:text-xl text-gray-600 dark:text-gray-400 leading-relaxed">
              센스냥은 교육, 기업 AI 분석, 상담 운영 도구를 기획·개발·운영합니다.
              사용자에게 필요한 기능을 안정적으로 제공하고, 실제 운영 데이터로 서비스를 개선합니다.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-4">
              <a href="#services" class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-gray-900 text-white hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100 transition-colors">
                사업 영역 보기
              </a>
              <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                제휴·문의하기
              </a>
            </div>
          </div>
          <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-6">
            <div class="grid grid-cols-2 gap-4">
              <div class="rounded-xl bg-white dark:bg-gray-950 p-5 border border-gray-200 dark:border-gray-800">
                <p class="text-3xl font-semibold">3</p>
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">운영·구축 사업</p>
              </div>
              <div class="rounded-xl bg-white dark:bg-gray-950 p-5 border border-gray-200 dark:border-gray-800">
                <p class="text-3xl font-semibold">2025</p>
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">통신판매업 신고</p>
              </div>
              <div class="col-span-2 rounded-xl bg-white dark:bg-gray-950 p-5 border border-gray-200 dark:border-gray-800">
                <p class="text-sm text-gray-500 dark:text-gray-400">Business</p>
                <p class="mt-2 text-xl font-semibold">교육 · AI 분석 · 상담 운영</p>
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">서비스 기획부터 개발, 배포, 운영까지 직접 수행합니다.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Services Section -->
      <section id="services" class="mb-20">
        <div class="flex flex-col items-start mb-10">
          <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Services</p>
          <h2 class="text-3xl md:text-4xl font-semibold mt-2">{t.sections.services}</h2>
          <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400">
            기존 서비스 중 센스매스를 중심으로, 기업 AI 분석과 상담 운영 도구를 사업 포트폴리오로 확장하고 있습니다.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {config.services.map((service) => (
            <ServiceCard service={service} locale={locale} />
          ))}
        </div>
      </section>

      <!-- What we build Section -->
      <section class="mb-20">
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-10 items-center">
          <div>
            <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Company</p>
            <h2 class="text-3xl md:text-4xl font-semibold mt-2">{t.sections.whatWeBuild}</h2>
            <div class="mt-6 space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
              <p class="text-lg">
                센스냥은 실사용자가 있는 서비스를 직접 기획하고 개발하는 디지털 서비스 회사입니다.
                단순한 아이디어 실험을 넘어, 서비스 운영에 필요한 데이터, 관리 도구, 고객 전달 흐름까지 함께 설계합니다.
              </p>
              <p class="text-lg">
                교육 서비스에서는 학습자의 진단과 보충 학습 경험을, 기업 AI 분석에서는 조직의 AI 활용과 비용 최적화를,
                상담 운영 도구에서는 상담사가 결과를 편리하게 생성하고 고객에게 전달하는 과정을 다룹니다.
              </p>
              <p class="text-lg">
                모든 서비스는 개인정보 보호와 안정적인 운영을 우선하며, 실제 사용자 피드백을 바탕으로 지속적으로 개선합니다.
              </p>
            </div>
          </div>
          <div class="relative">
            <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-8">
              <div class="space-y-6">
                <div>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Planning</p>
                  <p class="text-2xl font-semibold mt-2">서비스 기획</p>
                  <p class="text-gray-600 dark:text-gray-400 mt-2">문제 정의, 사용자 흐름, 운영 정책을 함께 설계합니다.</p>
                </div>
                <div class="h-px bg-gray-200 dark:bg-gray-800"></div>
                <div>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Development</p>
                  <p class="text-2xl font-semibold mt-2">웹 서비스 개발</p>
                  <p class="text-gray-600 dark:text-gray-400 mt-2">프론트엔드, 백엔드, 데이터 저장소, 배포 구성을 구현합니다.</p>
                </div>
                <div class="h-px bg-gray-200 dark:bg-gray-800"></div>
                <div>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Operation</p>
                  <p class="text-2xl font-semibold mt-2">운영 개선</p>
                  <p class="text-gray-600 dark:text-gray-400 mt-2">실제 사용 데이터를 바탕으로 기능과 콘텐츠를 개선합니다.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Updates Section -->
      <section class="mb-10">
        <div class="flex flex-col items-center mb-10">
          <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Updates</p>
          <h2 class="text-3xl md:text-4xl font-semibold mt-2">{t.sections.updates}</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {config.updates.map((update) => (
            <article class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/70 dark:bg-gray-900/60 backdrop-blur p-6 hover:shadow-lg transition-shadow">
              <time class="text-sm text-gray-500 dark:text-gray-400">{update.date}</time>
              <h3 class="text-xl font-semibold mt-2 mb-2">{update.title}</h3>
              <p class="text-gray-700 dark:text-gray-300">{update.content}</p>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
