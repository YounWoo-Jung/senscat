---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { getTranslations } from '../i18n';
import ServiceCard from '../components/ServiceCard.astro';

const locale = 'ko';
const t = getTranslations(locale);
const pageDescription = '센스냥은 센스AI(SensAI) 기업 AI 분석 플랫폼, 센스매스(Sensmath) AI 수학 학습 서비스를 기획·개발·운영하며, 외주개발·맞춤형 소프트웨어 개발도 의뢰받고 있습니다.';
const pageKeywords = ['센스AI', 'SensAI', '센스매스', 'Sensmath', '기업 AI 분석', 'AI 수학 학습', '센스냥', '외주개발', '외주 개발', '웹 개발 의뢰', '소프트웨어 외주'];
const heroStats = [
  { value: '2', label: '운영·구축 제품' },
  { value: 'AI', label: '분석·자동화 중심' },
  { value: '2025', label: '정식 사업 운영' },
];
const ideaSignals = ['학습 진단', 'AI 사용량', '구독 비용', '맞춤형 개발'];
const buildLoop = [
  { step: '01', title: '문제 신호 수집', description: '사용자 흐름과 운영 데이터를 제품 가설로 정리합니다.' },
  { step: '02', title: '빠른 제품화', description: '웹 서비스, 데이터 저장소, 관리자 도구를 함께 설계합니다.' },
  { step: '03', title: '운영 기반 개선', description: '실제 사용 피드백으로 기능과 콘텐츠를 계속 다듬습니다.' },
];
---

<BaseLayout title={`${t.site.name} — 센스AI·센스매스·외주개발 디지털 서비스 회사`} description={pageDescription} keywords={pageKeywords} locale={locale}>
  <div class="overflow-hidden">
    <section class="relative border-b border-gray-200 dark:border-gray-800">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(17,24,39,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(17,24,39,0.06)_1px,transparent_1px)] bg-[size:42px_42px] dark:bg-[linear-gradient(to_right,rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)]" aria-hidden="true"></div>
      <div class="container relative mx-auto px-4 py-20 md:py-24">
        <div class="grid gap-10 lg:grid-cols-[1.02fr_0.98fr] lg:items-center">
          <div class="max-w-3xl">
            <p class="inline-flex rounded-md border border-cyan-200 bg-cyan-50 px-3 py-1 text-sm font-semibold text-cyan-800 dark:border-cyan-900/70 dark:bg-cyan-950/40 dark:text-cyan-200">
              AI Product Studio
            </p>
            <h1 class="mt-6 text-4xl font-semibold leading-tight md:text-6xl">
              AI 아이디어를 제품으로 바꾸는 스타트업 스튜디오
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-600 dark:text-gray-300 md:text-xl">
              센스냥은 센스AI, 센스매스를 직접 만들고 운영하며,
              외주개발·맞춤형 소프트웨어 개발도 의뢰받고 있습니다.
              데이터 분석과 자동화가 필요한 서비스 아이디어를 빠르게 검증합니다.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="#services" class="inline-flex items-center justify-center rounded-lg bg-gray-950 px-6 py-3 font-semibold text-white shadow-lg shadow-gray-900/10 transition-colors hover:bg-gray-800 dark:bg-white dark:text-gray-950 dark:hover:bg-gray-200">
                사업 영역 보기
              </a>
              <a href="/contact" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-900 transition-colors hover:border-gray-900 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100 dark:hover:border-gray-300">
                외주개발·문의하기
              </a>
            </div>
            <dl class="mt-10 grid max-w-2xl grid-cols-3 border-y border-gray-200 bg-white/70 dark:border-gray-800 dark:bg-gray-950/40">
              {heroStats.map((stat) => (
                <div class="px-4 py-5 first:pl-0 [&:not(:first-child)]:border-l [&:not(:first-child)]:border-gray-200 dark:[&:not(:first-child)]:border-gray-800">
                  <dt class="text-2xl font-semibold">{stat.value}</dt>
                  <dd class="mt-1 text-sm text-gray-600 dark:text-gray-400">{stat.label}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="rounded-lg border border-gray-800 bg-[#0d1320] p-5 text-white shadow-2xl shadow-gray-900/20">
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
              <div>
                <p class="text-sm text-cyan-200">Idea Bank Console</p>
                <p class="mt-1 text-xl font-semibold">AI Service Pipeline</p>
              </div>
              <span class="rounded-md border border-emerald-300/30 bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-200">Live</span>
            </div>
            <div class="mt-5 grid gap-4 md:grid-cols-[1fr_0.9fr]">
              <div class="rounded-lg border border-white/10 bg-white/[0.04] p-4">
                <p class="text-sm text-gray-300">Signals</p>
                <div class="mt-4 grid grid-cols-2 gap-2">
                  {ideaSignals.map((signal) => (
                    <span class="rounded-md border border-white/10 bg-white/[0.05] px-3 py-2 text-sm text-gray-100">{signal}</span>
                  ))}
                </div>
              </div>
              <div class="rounded-lg border border-white/10 bg-white/[0.04] p-4">
                <p class="text-sm text-gray-300">Build Index</p>
                <p class="mt-4 text-5xl font-semibold">87</p>
                <div class="mt-4 h-2 rounded-sm bg-white/10">
                  <div class="h-2 w-4/5 rounded-sm bg-cyan-300"></div>
                </div>
                <p class="mt-3 text-xs text-gray-400">idea validation score</p>
              </div>
            </div>
            <div class="mt-4 rounded-lg border border-white/10 bg-white/[0.04] p-4">
              <div class="mb-4 flex items-center justify-between text-sm">
                <span class="text-gray-300">Prototype Flow</span>
                <span class="text-cyan-200">plan → build → operate</span>
              </div>
              <div class="grid gap-2">
                {config.services.map((service) => (
                  <div class="grid grid-cols-[44px_1fr_auto] items-center gap-3">
                    <span class="rounded-md border border-white/10 bg-white/[0.06] px-2 py-1 text-center text-xs font-semibold">{service.icon}</span>
                    <span class="text-sm">{service.name}</span>
                    <span class="h-2 w-24 rounded-sm bg-white/10">
                      <span class={`block h-2 rounded-sm ${service.id === 'sensai' ? 'w-3/5 bg-cyan-300' : 'w-5/6 bg-indigo-300'}`}></span>
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

    <section id="services" class="bg-white py-20 dark:bg-[#0d1117]">
      <div class="container mx-auto px-4">
        <div class="mb-10 grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div>
            <p class="text-sm font-semibold text-cyan-700 dark:text-cyan-300">Services</p>
            <h2 class="mt-3 text-3xl font-semibold md:text-4xl">아이디어를 실제 제품으로 운영합니다</h2>
          </div>
          <p class="max-w-2xl text-gray-600 dark:text-gray-300">
            센스매스(Sensmath)와 센스AI(SensAI)를 직접 기획·개발·운영하며,
            기업 및 스타트업의 맞춤형 소프트웨어 외주개발도 함께 진행합니다.
            각 제품은 기획, 개발, 배포, 운영 개선까지 직접 수행합니다.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {config.services.map((service) => (
            <ServiceCard service={service} locale={locale} />
          ))}
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold text-emerald-700 dark:text-emerald-300">Build Loop</p>
            <h2 class="mt-3 text-3xl font-semibold md:text-4xl">작게 검증하고 빠르게 고도화합니다</h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-300">
              센스냥은 실사용자가 있는 서비스를 직접 기획하고 개발하는 디지털 서비스 회사입니다.
              운영 데이터, 관리 도구, 고객 전달 흐름을 한 번에 설계해 제품 완성도를 높입니다.
            </p>
          </div>
          <div class="grid gap-4">
            {buildLoop.map((item) => (
              <div class="grid gap-4 rounded-lg border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-[#111821] sm:grid-cols-[64px_1fr]">
                <span class="text-2xl font-semibold text-gray-300 dark:text-gray-600">{item.step}</span>
                <div>
                  <h3 class="text-xl font-semibold">{item.title}</h3>
                  <p class="mt-2 text-gray-600 dark:text-gray-300">{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#111821] py-16 text-white">
      <div class="container mx-auto px-4">
        <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold text-cyan-200">Operating Intelligence</p>
            <h2 class="mt-3 text-3xl font-semibold md:text-4xl">AI 개발을 운영 지표와 연결합니다</h2>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            <div class="rounded-lg border border-white/10 bg-white/[0.04] p-5">
              <p class="text-sm text-gray-300">센스AI</p>
              <p class="mt-2 text-2xl font-semibold">AI 사용량 분석</p>
            </div>
            <div class="rounded-lg border border-white/10 bg-white/[0.04] p-5">
              <p class="text-sm text-gray-300">센스매스</p>
              <p class="mt-2 text-2xl font-semibold">학습 진단 데이터</p>
            </div>
            <div class="rounded-lg border border-white/10 bg-white/[0.04] p-5">
              <p class="text-sm text-gray-300">외주개발</p>
              <p class="mt-2 text-2xl font-semibold">맞춤형 개발</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="mb-10 flex flex-col gap-3">
          <p class="text-sm font-semibold text-gray-500 dark:text-gray-400">Updates</p>
          <h2 class="text-3xl font-semibold md:text-4xl">{t.sections.updates}</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {config.updates.map((update) => (
            <article class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-lg dark:border-gray-800 dark:bg-[#111821]">
              <time class="text-sm text-gray-500 dark:text-gray-400">{update.date}</time>
              <h3 class="text-xl font-semibold mt-2 mb-2">{update.title}</h3>
              <p class="text-gray-700 dark:text-gray-300">{update.content}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
