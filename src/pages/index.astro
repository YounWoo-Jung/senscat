---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { getTranslations } from '../i18n';
import ServiceCard from '../components/ServiceCard.astro';

const locale = 'ko';
const t = getTranslations(locale);
---

<BaseLayout title={`${t.site.name} — ${config.site.tagline}`} locale={locale}>
  <div class="container mx-auto px-4 py-12">
    <!-- Hero Section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl md:text-6xl font-bold mb-4">{t.hero.title}</h1>
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400">{t.hero.tagline}</p>
    </section>

    <!-- Services Section -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-center">{t.sections.services}</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {config.services.map((service) => (
          <ServiceCard service={service} locale={locale} />
        ))}
      </div>
    </section>

    <!-- What we build Section -->
    <section class="mb-16 max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold mb-6 text-center">{t.sections.whatWeBuild}</h2>
      <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        <p class="text-lg">
          센스냥은 작은 제품을 빠르게 실험하는 것을 목표로 합니다. 우리는 사용자에게 실질적인 가치를 제공하는 
          미니멀한 서비스들을 만들고 있습니다. 각 서비스는 독립적으로 운영되며, 사용자 피드백을 바탕으로 지속적으로 
          개선됩니다. 우리는 복잡한 기능보다는 핵심 가치에 집중하며, 빠른 반복과 실험을 통해 더 나은 경험을 제공합니다.
        </p>
        <p class="text-lg">
          우리의 서비스들은 모두 사용자 중심으로 설계되었으며, 개인정보 보호와 투명성을 최우선으로 합니다. 
          광고 수익 모델을 사용하더라도 사용자 경험을 해치지 않는 선에서 운영하며, 항상 사용자의 선택권을 존중합니다.
        </p>
        <p class="text-lg">
          센스냥의 각 제품은 작은 팀이나 개인이 운영하며, 빠른 의사결정과 유연한 개발이 가능합니다. 
          이를 통해 시장의 변화에 빠르게 대응하고, 사용자에게 최신의 기능과 경험을 제공할 수 있습니다.
        </p>
      </div>
    </section>

    <!-- Updates Section -->
    <section class="mb-16 max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold mb-6 text-center">{t.sections.updates}</h2>
      <div class="space-y-6">
        {config.updates.map((update) => (
          <article class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6">
            <time class="text-sm text-gray-500 dark:text-gray-400">{update.date}</time>
            <h3 class="text-xl font-semibold mt-2 mb-2">{update.title}</h3>
            <p class="text-gray-700 dark:text-gray-300">{update.content}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
