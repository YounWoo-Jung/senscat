---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { getTranslations } from '../i18n';

const locale = 'ko';
const t = getTranslations(locale);
const pageDescription = '센스냥은 센스매스(Sensmath), 센스AI(SensAI)를 직접 기획·개발·운영하며, 외주개발·맞춤형 소프트웨어 개발도 의뢰받는 디지털 서비스 회사입니다.';
const pageKeywords = ['센스냥 소개', '센스AI', 'SensAI', '센스매스', 'Sensmath', '기업 AI 분석', 'AI 수학', '외주개발', '외주 개발'];
---

<BaseLayout title={`${t.nav.about} — ${t.site.name}`} description={pageDescription} keywords={pageKeywords} locale={locale}>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <h1 class="text-4xl font-bold mb-8">{t.nav.about}</h1>
    
    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">센스냥 소개</h2>
      <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        <p class="text-lg">
          센스냥은 교육, 기업 AI 분석 분야의 디지털 서비스를 직접 기획·개발·운영하며,
          외주개발·맞춤형 소프트웨어 개발도 의뢰받고 있습니다.
          서비스가 실제 업무와 생활에서 자연스럽게 쓰일 수 있도록 제품 구조와 운영 흐름을 함께 설계합니다.
        </p>
        <p class="text-lg">
          센스매스(Sensmath)는 중학생 수학 학습을 돕는 교육 서비스이며, 센스AI(SensAI)는 기업의 AI 활용과 비용을 분석하는 플랫폼입니다.
          또한 기업 및 스타트업의 맞춤형 웹·앱 개발 외주도 함께 진행합니다.
        </p>
        <p class="text-lg">
          센스냥은 서비스별 핵심 사용 경험을 단순하게 유지하면서도, 개인정보 보호와 안정적인 운영을 중요하게 다룹니다.
        </p>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">운영 원칙</h2>
      <ul class="grid gap-4 md:grid-cols-3">
        <li>
          <strong class="text-lg">실용성</strong>
          <p class="text-gray-700 dark:text-gray-300">실제 사용자와 운영자가 바로 쓸 수 있는 기능에 집중합니다.</p>
        </li>
        <li>
          <strong class="text-lg">안정성</strong>
          <p class="text-gray-700 dark:text-gray-300">서비스 데이터와 고객 정보가 안전하게 다뤄지도록 설계합니다.</p>
        </li>
        <li>
          <strong class="text-lg">지속 개선</strong>
          <p class="text-gray-700 dark:text-gray-300">운영 중 확인되는 피드백과 데이터를 바탕으로 개선합니다.</p>
        </li>
      </ul>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">서비스 목적</h2>
      <div class="space-y-6">
        {config.services.map((service) => (
          <div class="rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-[#111821]">
            <h3 class="mb-2 flex items-center gap-3 text-xl font-semibold">
              <span class="grid h-9 w-9 place-items-center rounded-md border border-gray-200 bg-gray-50 text-xs font-semibold dark:border-gray-700 dark:bg-gray-950">
                {service.icon}
              </span>
              {service.name}
            </h3>
            <p class="text-gray-700 dark:text-gray-300">{service.description}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
