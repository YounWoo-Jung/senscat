---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { getTranslations } from '../i18n';
import ServiceIcon from '../components/ServiceIcon.astro';

const locale = 'ko';
const t = getTranslations(locale);
const pageDescription = '센스냥은 센스매스(Sensmath), 센스프로모(SensePromo)를 직접 기획·개발·운영하며, 외주개발·맞춤형 소프트웨어 개발도 의뢰받는 디지털 서비스 회사입니다.';
const pageKeywords = ['센스냥 소개', '센스프로모', 'SensePromo', '센스매스', 'Sensmath', 'AI 마케팅', 'AI 수학', '외주개발', '외주 개발'];
const principles = [
  { title: '실용성', description: '실제 사용자와 운영자가 바로 쓸 수 있는 기능에 집중합니다.' },
  { title: '안정성', description: '서비스 데이터와 고객 정보가 안전하게 다뤄지도록 설계합니다.' },
  { title: '지속 개선', description: '운영 중 확인되는 피드백과 데이터를 바탕으로 개선합니다.' },
];
---

<BaseLayout title={`${t.nav.about} — ${t.site.name}`} description={pageDescription} keywords={pageKeywords} locale={locale}>
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute -top-48 left-1/2 -z-10 h-72 w-[44rem] -translate-x-1/2 rounded-full bg-orange-200/50 blur-3xl dark:bg-orange-500/10" aria-hidden="true"></div>
    <div class="container mx-auto max-w-4xl px-4 pb-10 pt-16 md:pt-20">
      <p class="text-sm font-semibold text-orange-600 dark:text-orange-300">About</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight md:text-5xl">{t.nav.about}</h1>
    </div>
  </section>

  <div class="container mx-auto max-w-4xl space-y-14 px-4">
    <section>
      <h2 class="text-2xl font-bold tracking-tight">센스냥 소개</h2>
      <div class="mt-5 space-y-4 rounded-[1.75rem] border border-stone-200/80 bg-white p-7 text-lg leading-relaxed text-stone-700 shadow-sm dark:border-white/10 dark:bg-white/[0.04] dark:text-stone-300">
        <p>
          센스냥은 교육, AI 마케팅 분야의 디지털 서비스를 직접 기획·개발·운영하며,
          외주개발·맞춤형 소프트웨어 개발도 의뢰받고 있습니다.
          서비스가 실제 업무와 생활에서 자연스럽게 쓰일 수 있도록 제품 구조와 운영 흐름을 함께 설계합니다.
        </p>
        <p>
          센스매스(Sensmath)는 중학생 수학 학습을 돕는 교육 서비스이며, 센스프로모(SensePromo)는 온라인 판매자의 상품 홍보를 돕는 AI 마케팅 에이전트입니다.
          또한 기업 및 스타트업의 맞춤형 웹·앱 개발 외주도 함께 진행합니다.
        </p>
        <p>
          센스냥은 서비스별 핵심 사용 경험을 단순하게 유지하면서도, 개인정보 보호와 안정적인 운영을 중요하게 다룹니다.
        </p>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold tracking-tight">운영 원칙</h2>
      <ul class="mt-5 grid gap-4 md:grid-cols-3">
        {principles.map((principle, index) => (
          <li class="rounded-[1.75rem] border border-stone-200/80 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/[0.04]">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-orange-50 text-sm font-extrabold text-orange-600 dark:bg-orange-400/10 dark:text-orange-300">0{index + 1}</span>
            <strong class="mt-4 block text-lg font-bold">{principle.title}</strong>
            <p class="mt-1.5 text-stone-600 dark:text-stone-300">{principle.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-2xl font-bold tracking-tight">서비스 목적</h2>
      <div class="mt-5 space-y-4">
        {config.services.map((service) => (
          <div class="flex gap-5 rounded-[1.75rem] border border-stone-200/80 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/[0.04]">
            <ServiceIcon id={service.id} />
            <div>
              <h3 class="text-xl font-bold">{service.name}</h3>
              <p class="mt-1.5 leading-relaxed text-stone-600 dark:text-stone-300">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
