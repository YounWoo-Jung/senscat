---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { config } from '../../config';
import { getTranslations } from '../../i18n';
import ServiceIcon from '../../components/ServiceIcon.astro';

const locale = 'en';
const t = getTranslations(locale);
const pageDescription = 'Senscat operates 센스매스(Sensmath) and 센스프로모(SensePromo) as practical digital services for education and AI marketing. We also accept custom software development outsourcing inquiries.';
const pageKeywords = ['Senscat about', '센스프로모', 'SensePromo', '센스매스', 'Sensmath', 'AI marketing agent', 'middle school math', 'software development outsourcing', 'custom development'];
const principles = [
  { title: 'Experimentation', description: 'We quickly test new ideas and are not afraid of failure.' },
  { title: 'Transparency', description: 'We transparently disclose how services operate and communicate honestly with users.' },
  { title: 'User Respect', description: 'We respect user choice and privacy, always prioritizing user experience.' },
];
---

<BaseLayout title={`${t.nav.about} — ${t.site.name}`} description={pageDescription} keywords={pageKeywords} locale={locale}>
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute -top-48 left-1/2 -z-10 h-72 w-[44rem] -translate-x-1/2 rounded-full bg-orange-200/50 blur-3xl dark:bg-orange-500/10" aria-hidden="true"></div>
    <div class="container mx-auto max-w-4xl px-4 pb-10 pt-16 md:pt-20">
      <p class="text-sm font-semibold text-orange-600 dark:text-orange-300">About</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight md:text-5xl">{t.nav.about}</h1>
    </div>
  </section>

  <div class="container mx-auto max-w-4xl space-y-14 px-4">
    <section>
      <h2 class="text-2xl font-bold tracking-tight">About Senscat</h2>
      <div class="mt-5 space-y-4 rounded-[1.75rem] border border-stone-200/80 bg-white p-7 leading-relaxed text-stone-700 shadow-sm dark:border-white/10 dark:bg-white/[0.04] dark:text-stone-300">
        <p class="text-lg">
          Senscat is a digital service company that plans, develops, and operates services in education
          and AI marketing. We also accept custom software development outsourcing projects.
        </p>
        <p>
          센스매스(Sensmath) supports middle school math learning. 센스프로모(SensePromo) helps online sellers
          prepare weekly product promotions with AI. We also build custom software solutions for partner companies.
        </p>
        <p>
          We keep each service practical, stable, and respectful of personal data.
        </p>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold tracking-tight">Operating Principles</h2>
      <ul class="mt-5 grid gap-4 md:grid-cols-3">
        {principles.map((principle, index) => (
          <li class="rounded-[1.75rem] border border-stone-200/80 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/[0.04]">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-orange-50 text-sm font-extrabold text-orange-600 dark:bg-orange-400/10 dark:text-orange-300">0{index + 1}</span>
            <strong class="mt-4 block text-lg font-bold">{principle.title}</strong>
            <p class="mt-1.5 text-stone-600 dark:text-stone-300">{principle.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-2xl font-bold tracking-tight">Service Purposes</h2>
      <div class="mt-5 space-y-4">
        {config.services.map((service) => (
          <div class="flex gap-5 rounded-[1.75rem] border border-stone-200/80 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/[0.04]">
            <ServiceIcon id={service.id} />
            <div>
              <h3 class="text-xl font-bold">{service.name}</h3>
              <p class="mt-1.5 leading-relaxed text-stone-600 dark:text-stone-300">{service.descriptionEn}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
