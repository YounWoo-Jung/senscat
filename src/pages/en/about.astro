---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { config } from '../../config';
import { getTranslations } from '../../i18n';

const locale = 'en';
const t = getTranslations(locale);
const pageDescription = 'Senscat operates 센스매스(Sensmath), 센스AI(SensAI), and 센스타로 as practical digital services for education, enterprise AI analytics, and consultation operations.';
const pageKeywords = ['Senscat about', '센스AI', 'SensAI', '센스매스', 'Sensmath', 'enterprise AI analytics', 'middle school math'];
---

<BaseLayout title={`${t.nav.about} — ${t.site.name}`} description={pageDescription} keywords={pageKeywords} locale={locale}>
  <div class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-4xl font-bold mb-8">{t.nav.about}</h1>
    
    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">About Senscat</h2>
      <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        <p class="text-lg">
          Senscat is a digital service company that plans, develops, and operates services in education,
          enterprise AI analytics, and consultation operations.
        </p>
        <p>
          센스매스(Sensmath) supports middle school math learning. 센스AI(SensAI) helps organizations understand AI usage,
          productivity, and subscription costs. 센스타로(Senstaro) helps tarot consultants create, edit, and share readings.
        </p>
        <p>
          We keep each service practical, stable, and respectful of personal data.
        </p>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">Operating Principles</h2>
      <ul class="space-y-4">
        <li>
          <strong class="text-lg">Experimentation</strong>
          <p class="text-gray-700 dark:text-gray-300">We quickly test new ideas and are not afraid of failure.</p>
        </li>
        <li>
          <strong class="text-lg">Transparency</strong>
          <p class="text-gray-700 dark:text-gray-300">We transparently disclose how services operate and communicate honestly with users.</p>
        </li>
        <li>
          <strong class="text-lg">User Respect</strong>
          <p class="text-gray-700 dark:text-gray-300">We respect user choice and privacy, always prioritizing user experience.</p>
        </li>
      </ul>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">Service Purposes</h2>
      <div class="space-y-6">
        {config.services.map((service) => (
          <div class="rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-[#111821]">
            <h3 class="mb-2 flex items-center gap-3 text-xl font-semibold">
              <span class="grid h-9 w-9 place-items-center rounded-md border border-gray-200 bg-gray-50 text-xs font-semibold dark:border-gray-700 dark:bg-gray-950">
                {service.icon}
              </span>
              {service.name}
            </h3>
            <p class="text-gray-700 dark:text-gray-300">{service.descriptionEn}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
