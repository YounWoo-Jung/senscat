---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { config } from '../../config';
import { getTranslations } from '../../i18n';
import ServiceCard from '../../components/ServiceCard.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import CatMascot from '../../components/CatMascot.astro';
import Logo from '../../components/Logo.astro';

const locale = 'en';
const t = getTranslations(locale);
const pageDescription = 'Senscat plans, develops, and operates 센스프로모(SensePromo) AI marketing agent and 센스매스(Sensmath) AI math learning. We also accept custom software development outsourcing inquiries.';
const pageKeywords = ['센스프로모', 'SensePromo', '센스매스', 'Sensmath', 'AI marketing agent', 'AI math learning', 'Senscat', 'software development outsourcing', 'web development', 'custom development'];
const heroStats = [
  { value: '2', label: 'products in operation' },
  { value: 'AI', label: 'analytics and automation' },
  { value: '2025', label: 'registered business' },
];
const heroSignals = [
  { label: 'learning diagnosis', dot: 'bg-sky-400', position: '-top-[18px] left-8' },
  { label: 'A/B promo content', dot: 'bg-fuchsia-400', position: '-bottom-[18px] right-8 [animation-delay:-2s]' },
  { label: 'custom development', dot: 'bg-orange-400', position: '-bottom-[18px] left-10 [animation-delay:-4s]' },
];
const outsourcing = {
  category: 'Outsourcing',
  title: 'Custom software development',
  summary: 'Custom web & app development',
  status: 'Open for projects',
  description: 'We build web and app services for companies and startups, from planning to development, deployment, and continuous improvement.',
  features: ['Web & app development', 'AI & automation features', 'Admin & operations tools'],
  cta: 'Discuss a project',
};
const buildLoop = [
  { step: '01', title: 'Capture signals', description: 'Turn user flows and operating data into product hypotheses.', accent: 'from-orange-400 to-amber-400 shadow-orange-500/30' },
  { step: '02', title: 'Ship prototypes', description: 'Design web services, data storage, and admin tools together.', accent: 'from-rose-400 to-fuchsia-500 shadow-rose-500/30' },
  { step: '03', title: 'Improve in operation', description: 'Refine features and content through real usage feedback.', accent: 'from-violet-500 to-indigo-500 shadow-violet-500/30' },
];
const operatingSignals = [
  { id: 'sensmath', label: '센스매스', title: 'learning diagnostics' },
  { id: 'sensepromo', label: '센스프로모', title: 'promotion performance' },
  { id: 'outsourcing', label: 'Outsourcing', title: 'custom development' },
];
---

<BaseLayout title={`${t.site.name} — 센스프로모, 센스매스, custom development`} description={pageDescription} keywords={pageKeywords} locale={locale}>
  <div class="overflow-hidden">
    <section class="relative isolate">
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -left-40 -top-48 h-[34rem] w-[34rem] rounded-full bg-orange-300/40 blur-3xl dark:bg-orange-500/15"></div>
        <div class="absolute -right-32 top-0 h-[30rem] w-[30rem] rounded-full bg-violet-300/30 blur-3xl dark:bg-violet-600/15"></div>
        <div class="absolute -bottom-40 left-1/3 h-80 w-80 rounded-full bg-rose-200/50 blur-3xl dark:bg-rose-500/10"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle,rgba(120,72,32,0.14)_1px,transparent_1px)] bg-[size:22px_22px] [mask-image:radial-gradient(ellipse_at_top,black_20%,transparent_70%)] dark:bg-[radial-gradient(circle,rgba(255,255,255,0.07)_1px,transparent_1px)]"></div>
      </div>
      <div class="container mx-auto px-4 pb-16 pt-12 md:pb-28 md:pt-24">
        <div class="grid items-center gap-4 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
          <div>
            <p class="inline-flex items-center gap-2 rounded-full border border-orange-200/80 bg-white/70 px-3.5 py-1.5 text-sm font-semibold text-orange-700 shadow-sm backdrop-blur dark:border-orange-400/20 dark:bg-orange-400/10 dark:text-orange-200">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <ellipse cx="6.2" cy="10.2" rx="2.1" ry="2.6" />
                <ellipse cx="10" cy="6.4" rx="2.1" ry="2.7" />
                <ellipse cx="14" cy="6.4" rx="2.1" ry="2.7" />
                <ellipse cx="17.8" cy="10.2" rx="2.1" ry="2.6" />
                <path d="M12 11.2c-2.9 0-5.6 3.1-5.6 5.6 0 1.9 1.4 2.9 3 2.9 1.1 0 1.8-.5 2.6-.5s1.5.5 2.6.5c1.6 0 3-1 3-2.9 0-2.5-2.7-5.6-5.6-5.6Z" />
              </svg>
              AI Product Studio
            </p>
            <h1 class="mt-6 text-[2.5rem] font-extrabold leading-[1.15] tracking-tight sm:text-5xl lg:text-[3.6rem]">
              An AI startup studio turning ideas into <span class="bg-gradient-to-r from-orange-500 via-rose-500 to-violet-500 bg-clip-text text-transparent">operating services</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-stone-600 dark:text-stone-300">
              Senscat builds and operates 센스프로모 and 센스매스, and also accepts custom software development outsourcing projects.
              We validate service ideas that need data analytics and automation.
            </p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a href="#services" class="group inline-flex items-center justify-center gap-2 rounded-full bg-stone-900 px-7 py-3.5 font-semibold text-white shadow-lg shadow-stone-900/20 transition hover:-translate-y-0.5 hover:bg-stone-800 dark:bg-white dark:text-stone-900 dark:hover:bg-orange-100">
                Explore services
                <svg class="h-4 w-4 transition-transform group-hover:translate-y-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 4v11m-4.5-4.5L10 15l4.5-4.5" /></svg>
              </a>
              <a href="/en/contact" class="inline-flex items-center justify-center rounded-full border border-stone-900/10 bg-white/80 px-7 py-3.5 font-semibold text-stone-900 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:border-orange-300 hover:text-orange-600 dark:border-white/15 dark:bg-white/5 dark:text-stone-100 dark:hover:border-orange-300/60 dark:hover:text-orange-200">
                Contact
              </a>
            </div>
            <dl class="mt-12 grid max-w-xl grid-cols-3 divide-x divide-stone-900/10 rounded-2xl border border-stone-900/5 bg-white/70 shadow-sm backdrop-blur dark:divide-white/10 dark:border-white/10 dark:bg-white/[0.04]">
              {heroStats.map((stat) => (
                <div class="px-4 py-4 sm:px-5">
                  <dt class="text-2xl font-extrabold tracking-tight">{stat.value}</dt>
                  <dd class="mt-0.5 text-xs font-medium text-stone-500 dark:text-stone-400 sm:text-sm">{stat.label}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="relative mx-auto w-full max-w-md lg:max-w-none">
            <div class="relative mt-24 rounded-[2rem] border border-white bg-white/80 p-5 shadow-2xl shadow-orange-900/10 ring-1 ring-stone-900/5 backdrop-blur-xl dark:border-white/10 dark:bg-white/[0.05] dark:shadow-black/40 dark:ring-white/5 sm:p-7">
              <CatMascot class="pointer-events-none absolute bottom-full right-8 w-40 translate-y-3 sm:right-12" />
              {heroSignals.map((signal) => (
                <span class={`absolute z-10 hidden items-center gap-2 rounded-full bg-white px-3.5 py-2 text-sm font-semibold text-stone-700 shadow-lg shadow-stone-900/10 ring-1 ring-stone-900/5 motion-safe:animate-float dark:bg-[#211c29] dark:text-stone-200 dark:ring-white/10 sm:inline-flex ${signal.position}`} aria-hidden="true">
                  <span class={`h-2 w-2 rounded-full ${signal.dot}`}></span>
                  {signal.label}
                </span>
              ))}
              <p class="flex items-center gap-2 text-sm font-semibold text-stone-500 dark:text-stone-400">
                <Logo id="showcase" class="h-5 w-5" />
                What Senscat builds
              </p>
              <ul class="mt-5 space-y-3">
                {config.services.map((service) => (
                  <li>
                    <a href={service.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 rounded-2xl border border-stone-200/70 bg-white p-3.5 transition hover:border-orange-200 hover:shadow-md dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-white/20">
                      <ServiceIcon id={service.id} />
                      <span class="min-w-0 flex-1">
                        <span class="block font-bold">{service.name}</span>
                        <span class="block truncate text-sm text-stone-500 dark:text-stone-400">{service.category}</span>
                      </span>
                      <span class="shrink-0 rounded-full bg-stone-100 px-2.5 py-1 text-xs font-semibold text-stone-600 dark:bg-white/10 dark:text-stone-300">{service.status}</span>
                    </a>
                  </li>
                ))}
                <li>
                  <a href="/en/contact" class="flex items-center gap-4 rounded-2xl border border-stone-200/70 bg-white p-3.5 transition hover:border-orange-200 hover:shadow-md dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-white/20">
                    <ServiceIcon id="outsourcing" />
                    <span class="min-w-0 flex-1">
                      <span class="block font-bold">{outsourcing.category}</span>
                      <span class="block truncate text-sm text-stone-500 dark:text-stone-400">{outsourcing.summary}</span>
                    </span>
                    <span class="shrink-0 rounded-full bg-orange-50 px-2.5 py-1 text-xs font-semibold text-orange-700 dark:bg-orange-400/10 dark:text-orange-200">{outsourcing.status}</span>
                  </a>
                </li>
              </ul>
              <div class="mt-5 flex items-center justify-between gap-3 rounded-2xl bg-stone-900 px-5 py-3.5 text-sm text-white dark:bg-white/10">
                <span class="font-semibold">Plan → Build → Operate</span>
                <span class="text-stone-400">end to end</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="mb-12 grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div>
            <p class="text-sm font-semibold text-orange-600 dark:text-orange-300">Services</p>
            <h2 class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">Ideas become real products</h2>
          </div>
          <p class="max-w-2xl text-lg leading-relaxed text-stone-600 dark:text-stone-300">
            Starting with 센스매스(Sensmath), Senscat is expanding into 센스프로모(SensePromo) AI marketing for online sellers.
            We also provide custom software development outsourcing services.
            Each service is planned, built, deployed, and improved in-house.
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {config.services.map((service) => (
            <ServiceCard service={service} locale={locale} />
          ))}
          <article class="group relative isolate flex h-full flex-col overflow-hidden rounded-[1.75rem] bg-stone-900 p-7 text-white shadow-xl shadow-stone-900/20 transition duration-300 hover:-translate-y-1 dark:bg-gradient-to-br dark:from-[#2a1c1c] dark:to-[#1a1522] dark:ring-1 dark:ring-white/10 md:col-span-2 lg:col-span-1">
            <div class="pointer-events-none absolute -right-24 -top-24 -z-10 h-64 w-64 rounded-full bg-orange-500/30 blur-3xl" aria-hidden="true"></div>
            <div class="pointer-events-none absolute -bottom-24 -left-16 -z-10 h-56 w-56 rounded-full bg-violet-500/20 blur-3xl" aria-hidden="true"></div>
            <div class="flex items-start justify-between">
              <ServiceIcon id="outsourcing" size="lg" />
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-orange-200 ring-1 ring-inset ring-white/15">
                <span class="h-1.5 w-1.5 rounded-full bg-orange-400"></span>
                {outsourcing.status}
              </span>
            </div>
            <p class="mt-7 text-sm font-semibold text-stone-400">{outsourcing.category}</p>
            <h3 class="mt-1 text-2xl font-bold tracking-tight">{outsourcing.title}</h3>
            <p class="mt-3 leading-relaxed text-stone-300">{outsourcing.description}</p>
            <ul class="mt-6 space-y-2.5 text-sm font-medium text-stone-200">
              {outsourcing.features.map((feature) => (
                <li class="flex items-center gap-2.5">
                  <svg class="h-5 w-5 shrink-0 text-orange-300" viewBox="0 0 20 20" aria-hidden="true">
                    <circle cx="10" cy="10" r="8" fill="currentColor" opacity=".2" />
                    <path d="m6.5 10.2 2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-8">
              <a href="/en/contact" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-orange-500 to-rose-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-orange-500/25 transition hover:brightness-110">
                {outsourcing.cta}
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h11m-4-4.5 4.5 4.5-4.5 4.5" /></svg>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="border-y border-stone-900/5 bg-white/70 py-16 dark:border-white/5 dark:bg-white/[0.02] md:py-24">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold text-violet-600 dark:text-violet-300">Build Loop</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">Validate small, improve fast</h2>
          <p class="mt-5 text-lg leading-relaxed text-stone-600 dark:text-stone-300">
            Senscat plans and develops practical digital services with real users.
            We design operating data, admin tools, and customer delivery flows together.
          </p>
        </div>
        <ol class="mt-14 grid gap-6 md:grid-cols-3">
          {buildLoop.map((item) => (
            <li class="rounded-[1.75rem] border border-stone-200/80 bg-[#fffaf5] p-7 dark:border-white/10 dark:bg-white/[0.04]">
              <span class={`grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br text-base font-extrabold text-white shadow-lg ${item.accent}`}>{item.step}</span>
              <h3 class="mt-6 text-xl font-bold">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-stone-600 dark:text-stone-300">{item.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="relative isolate overflow-hidden rounded-[2rem] bg-stone-950 px-6 py-14 text-white ring-1 ring-stone-900 dark:bg-[#17131d] dark:ring-white/10 sm:px-12 md:py-16">
          <div class="pointer-events-none absolute -left-20 -top-24 -z-10 h-72 w-72 rounded-full bg-orange-500/30 blur-3xl" aria-hidden="true"></div>
          <div class="pointer-events-none absolute -bottom-28 right-0 -z-10 h-80 w-80 rounded-full bg-violet-600/30 blur-3xl" aria-hidden="true"></div>
          <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-center">
            <div>
              <p class="text-sm font-semibold text-orange-300">Operating Intelligence</p>
              <h2 class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">AI development tied to operating signals</h2>
            </div>
            <div class="grid gap-3 sm:grid-cols-3">
              {operatingSignals.map((signal) => (
                <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 backdrop-blur">
                  <ServiceIcon id={signal.id} size="sm" />
                  <p class="mt-4 text-sm text-stone-400">{signal.label}</p>
                  <p class="mt-1 text-xl font-bold">{signal.title}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-16 md:pb-24">
      <div class="container mx-auto px-4">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="text-sm font-semibold text-orange-600 dark:text-orange-300">Timeline</p>
            <h2 class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">{t.sections.updates}</h2>
          </div>
          <ol class="space-y-6 border-l-2 border-orange-200/70 pl-8 dark:border-white/10">
            {config.updates.map((update) => (
              <li class="relative">
                <span class="absolute -left-[41px] top-7 h-4 w-4 rounded-full border-4 border-[#fffaf5] bg-orange-400 dark:border-[#100e15]" aria-hidden="true"></span>
                <article class="rounded-[1.75rem] border border-stone-200/80 bg-white p-6 shadow-sm transition-shadow hover:shadow-lg dark:border-white/10 dark:bg-white/[0.04]">
                  <time datetime={update.date} class="inline-flex rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700 dark:bg-orange-400/10 dark:text-orange-200">{update.date}</time>
                  <h3 class="mt-3 text-xl font-bold">{update.titleEn}</h3>
                  <p class="mt-2 leading-relaxed text-stone-600 dark:text-stone-300">{update.contentEn}</p>
                </article>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section>
      <div class="container mx-auto px-4">
        <div class="relative isolate overflow-hidden rounded-[2rem] border border-stone-200/80 bg-white px-6 py-16 text-center shadow-sm dark:border-white/10 dark:bg-white/[0.04] sm:px-12">
          <div class="pointer-events-none absolute -left-16 -top-16 -z-10 h-56 w-56 rounded-full bg-orange-100/70 blur-3xl dark:bg-orange-500/10" aria-hidden="true"></div>
          <div class="pointer-events-none absolute -bottom-20 -right-10 -z-10 h-64 w-64 rounded-full bg-rose-100/70 blur-3xl dark:bg-violet-500/10" aria-hidden="true"></div>
          <span class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-orange-50 ring-1 ring-orange-200/60 dark:bg-orange-400/10 dark:ring-orange-300/20">
            <Logo id="cta" class="h-11 w-11" />
          </span>
          <h2 class="mt-6 text-3xl font-extrabold tracking-tight md:text-4xl">Have an idea to build together?</h2>
          <p class="mx-auto mt-4 max-w-xl text-lg text-stone-600 dark:text-stone-300">
            We welcome custom software development, outsourcing, and partnership inquiries.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="/en/contact" class="inline-flex items-center justify-center rounded-full bg-stone-900 px-7 py-3.5 font-semibold text-white shadow-lg shadow-stone-900/20 transition hover:-translate-y-0.5 hover:bg-stone-800 dark:bg-white dark:text-stone-900 dark:hover:bg-orange-100">
              Contact us
            </a>
            <a href={`mailto:${config.company.email}`} class="inline-flex items-center justify-center rounded-full bg-white/80 px-7 py-3.5 font-semibold text-stone-900 ring-1 ring-inset ring-stone-900/10 transition hover:text-orange-600 hover:ring-orange-300 dark:bg-white/5 dark:text-stone-100 dark:ring-white/15 dark:hover:text-orange-200">
              {config.company.email}
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
