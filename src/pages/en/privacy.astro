---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { getTranslations } from '../i18n';

const locale = 'en';
const t = getTranslations(locale);
---

<BaseLayout title={`${t.nav.privacy} — ${config.site.name}`} locale={locale}>
  <div class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-4xl font-bold mb-8">{t.nav.privacy}</h1>
    
    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">1. Purpose of Collection and Use of Personal Information</h2>
      <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        <p class="text-lg">
          Senscat processes personal information for the following purposes. The personal information being processed 
          is not used for purposes other than those stated below, and if the purpose of use changes, we will take 
          necessary measures such as obtaining separate consent in accordance with Article 18 of the Personal Information Protection Act.
        </p>
        <ul class="list-disc list-inside space-y-2 ml-4">
          <li>Processing and responding to inquiries through contact forms</li>
          <li>Collecting feedback for service improvement</li>
          <li>Fulfilling obligations under laws and regulations</li>
        </ul>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">2. Personal Information Items Collected</h2>
      <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        <p class="text-lg">When making inquiries through contact forms, the following information may be collected:</p>
        <ul class="list-disc list-inside space-y-2 ml-4">
          <li>Email address</li>
          <li>Name (optional)</li>
          <li>Inquiry content</li>
        </ul>
        <p>
          Information automatically collected when visiting the website: IP address, cookies, visit date and time, service usage records, etc.
        </p>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">3. Third-Party Advertising Networks and Cookies</h2>
      <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        <p class="text-lg">
          Senscat may use third-party advertising networks including Google AdSense. These advertising networks may use 
          cookies and other technologies to provide ads relevant to users' interests.
        </p>
        <p>
          Cookies are small text files that websites store on users' browsers. Cookies are used for the following purposes:
        </p>
        <ul class="list-disc list-inside space-y-2 ml-4">
          <li>Storing user preferences and settings</li>
          <li>Advertising targeting and effectiveness measurement</li>
          <li>Service usage statistics analysis</li>
        </ul>
        <p>
          Users can refuse the use of cookies through browser settings. However, refusing cookies may limit the use of some services.
        </p>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">4. Retention and Use Period of Personal Information</h2>
      <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        <p class="text-lg">
          Collected personal information is, in principle, destroyed without delay after the purpose of collection and use is achieved. 
          However, if there is a need to retain it under relevant laws, it will be kept for the required period.
        </p>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">5. Provision of Personal Information to Third Parties</h2>
      <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        <p class="text-lg">
          Senscat, in principle, does not provide users' personal information to external parties. However, exceptions are made in the following cases:
        </p>
        <ul class="list-disc list-inside space-y-2 ml-4">
          <li>When the user has given prior consent</li>
          <li>When required by law</li>
          <li>When providing minimum necessary information for service provision (e.g., payment processing companies)</li>
        </ul>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">6. Personal Information Protection Officer</h2>
      <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        <p class="text-lg">
          If you have any inquiries regarding personal information processing, please contact us below.
        </p>
        <p>
          Email: <a href={`mailto:${config.site.email}`} class="text-blue-600 dark:text-blue-400">{config.site.email}</a>
        </p>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">7. Changes to Privacy Policy</h2>
      <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
        <p class="text-lg">
          This privacy policy may be updated to reflect changes in laws, policies, or security technologies. 
          Any additions, deletions, or modifications will be notified through the website's notice board 7 days before the implementation date.
        </p>
        <p>Effective Date: February 6, 2025</p>
      </div>
    </section>
  </div>
</BaseLayout>
