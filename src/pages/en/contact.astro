---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { config } from '../../config';
import { getTranslations } from '../../i18n';

const locale = 'en';
const t = getTranslations(locale);
---

<BaseLayout title={`${t.nav.contact} — ${config.site.name}`} locale={locale}>
  <div class="container mx-auto px-4 py-12 max-w-2xl">
    <h1 class="text-4xl font-bold mb-8">{t.nav.contact}</h1>
    
    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">Email Contact</h2>
      <p class="mb-4 text-gray-700 dark:text-gray-300">
        If you have any inquiries, please contact us at the email below.
      </p>
      <a 
        href={`mailto:${config.site.email}`}
        class="text-blue-600 dark:text-blue-400 hover:underline text-lg"
      >
        {config.site.email}
      </a>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">Inquiry Types</h2>
      <ul class="space-y-2 text-gray-700 dark:text-gray-300">
        <li>• Service-related inquiries and suggestions</li>
        <li>• Bug reports and technical support</li>
        <li>• Partnership and collaboration proposals</li>
        <li>• Advertising and marketing inquiries</li>
        <li>• Other general inquiries</li>
      </ul>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">External Contact Form</h2>
      <p class="mb-4 text-gray-700 dark:text-gray-300">
        If you prefer to use a contact form instead of email, please use the link below.
      </p>
      <a 
        href="https://formspree.io" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition-colors"
      >
        Open Formspree Contact Form
      </a>
    </section>
  </div>
</BaseLayout>
