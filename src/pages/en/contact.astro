---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { config } from '../../config';
import { getTranslations } from '../../i18n';

const locale = 'en';
const t = getTranslations(locale);
const pageDescription = 'Contact Senscat for custom software development outsourcing, 센스매스 and 센스AI partnerships, service adoption, and technical support.';
const pageKeywords = ['Senscat contact', '센스AI inquiry', '센스매스 inquiry', 'SensAI', 'Sensmath', 'service partnership', 'software development outsourcing', 'custom development'];
---

<BaseLayout title={`${t.nav.contact} — ${t.site.name}`} description={pageDescription} keywords={pageKeywords} locale={locale}>
  <section class="border-b border-gray-200 bg-white py-16 dark:border-gray-800 dark:bg-[#0d1117]">
    <div class="container mx-auto max-w-4xl px-4">
      <p class="text-sm font-semibold text-cyan-700 dark:text-cyan-300">Contact</p>
      <h1 class="mt-3 text-4xl font-semibold md:text-5xl">{t.nav.contact}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        Contact Senscat for custom software development outsourcing, 센스매스 and 센스AI partnerships, adoption, and technical support.
      </p>
    </div>
  </section>

  <section class="container mx-auto grid max-w-4xl gap-6 px-4 py-12 md:grid-cols-[0.9fr_1.1fr]">
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-[#111821]">
      <h2 class="text-2xl font-semibold">Email Contact</h2>
      <p class="mt-3 text-gray-700 dark:text-gray-300">
        If you have any inquiries, please contact us at the email below.
      </p>
      <a 
        href={`mailto:${config.site.email}`}
        class="mt-6 inline-flex rounded-lg border border-gray-300 px-4 py-3 font-semibold text-gray-900 hover:border-gray-900 hover:bg-gray-950 hover:text-white dark:border-gray-700 dark:text-gray-100 dark:hover:border-gray-200 dark:hover:bg-white dark:hover:text-gray-950"
      >
        {config.site.email}
      </a>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-[#111821]">
      <h2 class="text-2xl font-semibold">Inquiry Types</h2>
      <ul class="mt-5 grid gap-3 text-gray-700 dark:text-gray-300">
        <li class="border-l-2 border-amber-500 pl-3">Custom software development outsourcing</li>
        <li class="border-l-2 border-cyan-500 pl-3">센스매스 and 센스AI inquiries</li>
        <li class="border-l-2 border-emerald-500 pl-3">Partnerships and service adoption</li>
        <li class="border-l-2 border-indigo-500 pl-3">Technical support and operation inquiries</li>
        <li class="border-l-2 border-rose-500 pl-3">Other general inquiries</li>
      </ul>
    </div>
  </section>
</BaseLayout>
