---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { config } from '../../config';
import { getTranslations } from '../../i18n';

const locale = 'en';
const t = getTranslations(locale);
const pageDescription = 'Contact Senscat for custom software development outsourcing, 센스매스 and 센스프로모 partnerships, service adoption, and technical support.';
const pageKeywords = ['Senscat contact', '센스프로모 inquiry', '센스매스 inquiry', 'SensePromo', 'Sensmath', 'service partnership', 'software development outsourcing', 'custom development'];
const inquiryTypes = [
  { label: 'Custom software development outsourcing', dot: 'bg-amber-500' },
  { label: '센스매스 and 센스프로모 inquiries', dot: 'bg-cyan-500' },
  { label: 'Partnerships and service adoption', dot: 'bg-emerald-500' },
  { label: 'Technical support and operation inquiries', dot: 'bg-indigo-500' },
  { label: 'Other general inquiries', dot: 'bg-rose-500' },
];
---

<BaseLayout title={`${t.nav.contact} — ${t.site.name}`} description={pageDescription} keywords={pageKeywords} locale={locale}>
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute -top-48 left-1/2 -z-10 h-72 w-[44rem] -translate-x-1/2 rounded-full bg-rose-200/50 blur-3xl dark:bg-rose-500/10" aria-hidden="true"></div>
    <div class="container mx-auto max-w-4xl px-4 pb-10 pt-16 md:pt-20">
      <p class="text-sm font-semibold text-orange-600 dark:text-orange-300">Contact</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight md:text-5xl">{t.nav.contact}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-stone-600 dark:text-stone-300">
        Contact Senscat for custom software development outsourcing, 센스매스 and 센스프로모 partnerships, adoption, and technical support.
      </p>
    </div>
  </section>

  <section class="container mx-auto grid max-w-4xl gap-6 px-4 md:grid-cols-[0.9fr_1.1fr]">
    <div class="relative isolate overflow-hidden rounded-[1.75rem] bg-stone-900 p-7 text-white shadow-xl shadow-stone-900/20 dark:bg-white/[0.06] dark:ring-1 dark:ring-white/10">
      <div class="pointer-events-none absolute -right-16 -top-16 -z-10 h-48 w-48 rounded-full bg-orange-500/30 blur-3xl" aria-hidden="true"></div>
      <span class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-orange-400 to-rose-500 shadow-lg shadow-orange-500/30" aria-hidden="true">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg>
      </span>
      <h2 class="mt-6 text-2xl font-bold">Email Contact</h2>
      <p class="mt-2 text-stone-300">
        If you have any inquiries, please contact us at the email below.
      </p>
      <a
        href={`mailto:${config.site.email}`}
        class="mt-7 inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 font-semibold text-stone-900 transition-colors hover:bg-orange-100"
      >
        {config.site.email}
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h11m-4-4.5 4.5 4.5-4.5 4.5" /></svg>
      </a>
    </div>

    <div class="rounded-[1.75rem] border border-stone-200/80 bg-white p-7 shadow-sm dark:border-white/10 dark:bg-white/[0.04]">
      <h2 class="text-2xl font-bold">Inquiry Types</h2>
      <ul class="mt-5 grid gap-2.5 text-stone-700 dark:text-stone-300">
        {inquiryTypes.map((type) => (
          <li class="flex items-center gap-3 rounded-2xl bg-stone-50 px-4 py-3 dark:bg-white/[0.04]">
            <span class={`h-2.5 w-2.5 shrink-0 rounded-full ${type.dot}`}></span>
            {type.label}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
