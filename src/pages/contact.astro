---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { getTranslations } from '../i18n';

const locale = 'ko';
const t = getTranslations(locale);
---

<BaseLayout title={`${t.nav.contact} — ${t.site.name}`} locale={locale}>
  <div class="container mx-auto px-4 py-12 max-w-2xl">
    <h1 class="text-4xl font-bold mb-8">{t.nav.contact}</h1>
    
    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">이메일 연락</h2>
      <p class="mb-4 text-gray-700 dark:text-gray-300">
        문의사항이 있으시면 아래 이메일로 연락해 주세요.
      </p>
      <a 
        href={`mailto:${config.site.email}`}
        class="text-blue-600 dark:text-blue-400 hover:underline text-lg"
      >
        {config.site.email}
      </a>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">문의 유형</h2>
      <ul class="space-y-2 text-gray-700 dark:text-gray-300">
        <li>• 서비스 관련 문의 및 제안</li>
        <li>• 버그 리포트 및 기술 지원</li>
        <li>• 파트너십 및 협업 제안</li>
        <li>• 광고 및 마케팅 문의</li>
        <li>• 기타 일반 문의</li>
      </ul>
    </section>

  </div>
</BaseLayout>
