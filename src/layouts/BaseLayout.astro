---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getTranslations, type Locale } from '../i18n';
import { config } from '../config';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const { title, description, locale = 'ko' } = Astro.props;
const t = getTranslations(locale);
const siteName = t.site.name;
const defaultDescription = `${siteName} — ${t.hero.tagline}`;
const metaDescription = description ?? defaultDescription;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og.svg', Astro.site);

const currentPath = Astro.url.pathname;
const enPath = locale === 'ko'
  ? `/en${currentPath === '/' ? '' : currentPath}`
  : currentPath;
const koPath = locale === 'en'
  ? currentPath.replace(/^\/en/, '') || '/'
  : currentPath;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: siteName,
      url: Astro.site?.href,
      logo: ogImageURL.href,
      email: config.company.email,
      address: config.company.address,
    },
    {
      '@type': 'WebSite',
      name: siteName,
      url: Astro.site?.href,
      inLanguage: locale,
    },
    {
      '@type': 'WebPage',
      name: title,
      url: canonicalURL.href,
      isPartOf: {
        '@type': 'WebSite',
        name: siteName,
        url: Astro.site?.href,
      },
      inLanguage: locale,
      description: metaDescription,
    },
  ],
};
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="ko" href={new URL(koPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:alt" content={t.og.imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      // 다크모드 초기화
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </body>
</html>
